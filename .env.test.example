# Variabili d'ambiente per i test E2E con Playwright
# Copiare in .env.test (gitignored) e compilare con valori reali

# Abilita il login di test (OBBLIGATORIO per i test E2E)
ENABLE_TEST_LOGIN=true

# Password per il login di test (default: karibu-test)
TEST_PASSWORD=karibu-test

# Email dell'utente ADMIN/COACH usato per creare sessioni di test e generare squadre
E2E_ADMIN_EMAIL=admin@example.com

# Email di un utente ATHLETE con sportRole impostato (per Journey 2)
# L'utente deve esistere nel DB e avere un ruolo Baskin assegnato
E2E_ATHLETE_EMAIL=atleta@example.com
