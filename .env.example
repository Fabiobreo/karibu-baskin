# Database (Neon PostgreSQL)
# Ottieni da: https://neon.tech — usa branch separati per dev e produzione
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Google OAuth
# Crea un'app su https://console.cloud.google.com
# Redirect URI: https://tuodominio.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Auth.js v5 secret — genera con: openssl rand -base64 32
AUTH_SECRET=""

# URL pubblico del sito (senza slash finale)
NEXTAUTH_URL="http://localhost:3000"

# Web Push (VAPID)
# Genera le chiavi una volta sola con:
#   node -e "const wp=require('web-push'); console.log(wp.generateVAPIDKeys())"
# ATTENZIONE: cambiare le chiavi invalida tutte le subscription degli utenti
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="admin@karibubaskin.it"

# Email transazionali (Resend)
# Crea un account su https://resend.com
RESEND_API_KEY=""
CONTACT_EMAIL="asdkaribubaskin@gmail.com"

# Vercel Blob — upload immagini (avatar, squadre, partite, eventi, post)
# Su Vercel viene iniettato automaticamente collegando uno store Blob.
# In locale: copia il token dallo store (Vercel Dashboard → Storage → Blob).
BLOB_READ_WRITE_TOKEN=""

# Cron job secret (per i job in /api/cron/*)
# Genera con: openssl rand -base64 32
CRON_SECRET=""

# Gallery — feed Instagram (Instagram Graph API, account Business collegato a Pagina FB)
# IG_ACCESS_TOKEN: token long-lived (Page o System User token dal Business Manager)
# IG_BUSINESS_ACCOUNT_ID: ID dell'account Instagram Business
IG_ACCESS_TOKEN=""
IG_BUSINESS_ACCOUNT_ID=""
GALLERY_SYNC_LIMIT="24"   # quanti post recuperare ad ogni sync (opzionale)
GALLERY_MAX_POSTS="60"    # quanti post mantenere in totale (opzionale)

# Gallery — sezione video YouTube (feed RSS pubblico, nessuna API key)
# ID del canale, formato UCxxxxxxxx
YOUTUBE_CHANNEL_ID=""

# Test login — NON abilitare in produzione
ENABLE_TEST_LOGIN=false
TEST_PASSWORD="karibu-test"
