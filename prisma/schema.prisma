generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enum ruoli applicativi ────────────────────────────────────────────────────

enum AppRole {
  GUEST
  ATHLETE
  PARENT
  COACH
  ADMIN
}

enum Gender {
  MALE
  FEMALE
}

enum MatchType {
  LEAGUE      // campionato
  TOURNAMENT  // torneo
  FRIENDLY    // amichevole
}

enum MatchResult {
  WIN
  LOSS
  DRAW
}

// ── Auth.js v5 — modelli standard (Prisma adapter) ───────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  customImage   String?   // immagine caricata dall'utente (priorità su image da Google)
  createdAt     DateTime  @default(now())

  appRole   AppRole @default(GUEST)
  slug      String? @unique  // es. "mario-rossi" — URL slug leggibile, generato dal nome

  // Campi atleta
  sportRole        Int?
  sportRoleVariant String?   // "S", "T", "P", "R" — null per variante standard
  gender           Gender?
  birthDate        DateTime?

  // Ruolo suggerito dall'autovalutazione (in attesa di conferma admin)
  sportRoleSuggested        Int?
  sportRoleSuggestedVariant String?

  // Preferenze notifiche: { push: { NEW_TRAINING: bool, ... }, inApp: { ... } }
  // null = tutto abilitato (default)
  notifPrefs Json?

  accounts              Account[]
  authSessions          Session[]
  registrations         Registration[]
  children              Child[]               @relation("ParentChildren")
  childAccount          Child?                @relation("ChildUser")
  sportRoleHistory      SportRoleHistory[]
  pushSubscriptions     PushSubscription[]
  teamMemberships       TeamMembership[]
  matchStats            PlayerMatchStats[]
  callups               MatchCallup[]
  matchMvps             MatchMvp[]
  matchAvailabilities   MatchAvailability[]
  notificationReads     AppNotificationRead[]
  targetedNotifications AppNotification[]     @relation("TargetedNotifications")
  sentLinkRequests      LinkRequest[]         @relation("SentLinkRequests")
  receivedLinkRequests  LinkRequest[]         @relation("ReceivedLinkRequests")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Push notifications ────────────────────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  // null = utente non loggato (anonimo)
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Storico ruolo sportivo atleta ────────────────────────────────────────────

model SportRoleHistory {
  id        String   @id @default(cuid())
  userId    String
  sportRole Int
  changedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, changedAt])
}

// ── Figli gestiti da un genitore (senza account proprio) ─────────────────────

model Child {
  id               String    @id @default(cuid())
  parentId         String
  name             String
  sportRole        Int?
  sportRoleVariant String?
  gender           Gender?
  birthDate        DateTime?
  createdAt        DateTime  @default(now())

  // Consenso del genitore/tutore al trattamento dei dati del minore (GDPR art. 8 + D.Lgs. 196/2003)
  // null = consenso non ancora registrato (record creati prima dell'introduzione del flag)
  parentalConsentAt DateTime?

  // Collegamento opzionale a un account User (se il figlio si registra in futuro)
  userId String? @unique

  parent          User             @relation("ParentChildren", fields: [parentId], references: [id], onDelete: Cascade)
  user            User?            @relation("ChildUser", fields: [userId], references: [id], onDelete: SetNull)
  registrations   Registration[]
  teamMemberships TeamMembership[]
  matchStats      PlayerMatchStats[]
  callups         MatchCallup[]
  matchMvps       MatchMvp[]
  matchAvailabilities MatchAvailability[]
  linkRequests    LinkRequest[]

  @@index([parentId])
}

model LinkRequest {
  id           String            @id @default(cuid())
  childId      String
  parentId     String
  targetUserId String
  status       LinkRequestStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  expiresAt    DateTime?         // null = non scade; PENDING scadute vengono ignorate

  child      Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  parent     User  @relation("SentLinkRequests", fields: [parentId], references: [id], onDelete: Cascade)
  targetUser User  @relation("ReceivedLinkRequests", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId, status])
  @@index([parentId])
}

// ── Modelli esistenti (invariati nella tabella DB) ───────────────────────────

// Rinominato in Prisma per evitare conflitti con AuthSession,
// ma la tabella resta "Session" grazie a @@map
model TrainingSession {
  id            String          @id @default(cuid())
  title         String
  date          DateTime        // orario di inizio
  endTime       DateTime?       // orario di fine (nullable per retrocompatibilità)
  createdAt     DateTime        @default(now())
  teams         Json?
  dateSlug      String?         @unique  // es. "2025-03-15T18:00" — URL slug leggibile
  registrations Registration[]
  matchResults  TrainingMatchResult[]

  // Squadra agonistica di riferimento (null = allenamento per tutti / misti per ruolo)
  teamId String?
  team   CompetitiveTeam? @relation("TrainingTeam", fields: [teamId], references: [id], onDelete: SetNull)

  // Restrizioni iscrizione
  allowedRoles   Int[]            @default([])  // vuoto = tutti i ruoli ammessi
  restrictTeamId String?                        // null = nessuna restrizione per squadra
  openRoles      Int[]            @default([])  // ruoli esenti dalla restrizione di squadra
  restrictTeam   CompetitiveTeam? @relation("TrainingRestriction", fields: [restrictTeamId], references: [id], onDelete: SetNull)

  // Apertura/chiusura iscrizioni
  registrationOpen      Boolean   @default(false)  // false = "in arrivo" (mai aperto) o "iscrizioni chiuse" (chiuso manualmente)
  registrationOpenedAt  DateTime?                  // timestamp prima apertura — distingue "mai aperto" da "chiuso manualmente"
  openReminderSentAt    DateTime?                  // ultima notifica reminder agli admin per allenamento non ancora aperto

  // Gestione admin
  managedAt      DateTime?                      // impostato quando lo staff conclude la gestione post-allenamento

  @@index([date])
  @@index([teamId])
  @@index([restrictTeamId])
  @@map("TrainingSession")
}

model Registration {
  id        String   @id @default(cuid())
  sessionId String
  name      String
  role      Int
  note               String?  // comunicazione libera dell'atleta (es. "Devo uscire prima")
  anonymousEmail     String?  // email opzionale per iscrizioni anonime (per riconoscimento futuro)
  registeredAsCoach  Boolean  @default(false) // coach che partecipa come allenatore (non atleta)
  attended           Boolean? // null = non marcato, true = presente, false = assente (solo staff)
  createdAt DateTime @default(now())

  // Chi è iscritto (al più uno non-null):
  // userId  → utente con account che si iscrive da solo
  // childId → figlio senza account, iscritto dal genitore
  // entrambi null → iscrizione anonima (legacy)
  userId  String?
  childId String?

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  child   Child?          @relation(fields: [childId], references: [id], onDelete: SetNull)

  @@unique([sessionId, userId])
  @@unique([sessionId, childId])
  @@index([sessionId, role])
  @@index([userId])
  @@index([childId])
}

// ── Risultati partitelle di allenamento ──────────────────────────────────────

model TrainingMatchResult {
  id        String          @id @default(cuid())
  sessionId String
  matchup   String?                      // "AB" | "AC" | "BC" — identifica le due squadre che si scontrano
  scoreA    Int             @default(0)  // punteggio della prima squadra del matchup
  scoreB    Int             @default(0)  // punteggio della seconda squadra del matchup
  scoreC    Int?                         // non più usato (legacy)
  notes     String?         @db.Text
  createdAt DateTime        @default(now())

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

// ── Squadre agonistiche ───────────────────────────────────────────────────────

model Season {
  label     String   @id          // es. "2025-26"
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
}

model CompetitiveTeam {
  id           String   @id @default(cuid())
  name         String
  season       String   // es. "2024-25", "2025-26"
  championship String?  // es. "Gold Ovest", "Silver Ovest"
  color        String?  // colore hex (es. "#E65100")
  description  String?  @db.Text
  imageUrl     String?  // copertina squadra (Vercel Blob)
  createdAt    DateTime @default(now())

  memberships          TeamMembership[]
  matches              Match[]           @relation("MatchTeam")
  opponentInMatches    Match[]           @relation("MatchOpponentTeam")
  callups              MatchCallup[]     @relation("MatchCallupTeam")
  groups               GroupCompetitiveTeam[]
  trainingSessions     TrainingSession[] @relation("TrainingTeam")
  restrictedSessions   TrainingSession[] @relation("TrainingRestriction")

  @@index([season])
}

model TeamMembership {
  id        String   @id @default(cuid())
  teamId    String
  isCaptain Boolean  @default(false)
  createdAt DateTime @default(now())

  // Esattamente uno dei due deve essere valorizzato
  userId  String?
  childId String?

  team  CompetitiveTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user  User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  child Child?          @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@unique([teamId, childId])
  @@index([teamId])
  @@index([userId])
  @@index([childId])
}

// ── Squadre avversarie ────────────────────────────────────────────────────────

model OpposingTeam {
  id        String   @id @default(cuid())
  name      String
  slug      String?  @unique
  city      String?
  address   String?
  website   String?
  colors    String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  matches        Match[]
  homeGroupMatches GroupMatch[] @relation("GroupMatchHome")
  awayGroupMatches GroupMatch[] @relation("GroupMatchAway")
  groupTeams       GroupTeam[]
}

// ── Gironi campionato ─────────────────────────────────────────────────────────

model Group {
  id           String   @id @default(cuid())
  slug         String?  @unique // es. "2025-26-girone-a-ovest"
  name         String   // es. "Girone A Ovest"
  season       String   // es. "2025-26"
  championship String?  // es. "Gold", "Silver"
  createdAt    DateTime @default(now())

  matches          Match[]
  groupMatches     GroupMatch[]
  groupTeams       GroupTeam[]
  competitiveTeams GroupCompetitiveTeam[]

  @@index([season])
}

// ── Associazione esplicita nostra squadra ↔ girone ────────────────────────────
// Più di una nostra squadra può essere nello stesso girone.
model GroupCompetitiveTeam {
  id                String   @id @default(cuid())
  groupId           String
  competitiveTeamId String
  createdAt         DateTime @default(now())

  group           Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  competitiveTeam CompetitiveTeam @relation(fields: [competitiveTeamId], references: [id], onDelete: Cascade)

  @@unique([groupId, competitiveTeamId])
  @@index([groupId])
  @@index([competitiveTeamId])
}

// ── Associazione esplicita squadra avversaria ↔ girone ────────────────────────
// Permette di associare una squadra al girone anche senza partite inserite.
model GroupTeam {
  id             String   @id @default(cuid())
  groupId        String
  opposingTeamId String
  createdAt      DateTime @default(now())

  group        Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  opposingTeam OpposingTeam @relation(fields: [opposingTeamId], references: [id], onDelete: Cascade)

  @@unique([groupId, opposingTeamId])
  @@index([groupId])
  @@index([opposingTeamId])
}

// ── Risultati partite tra altre squadre del girone ────────────────────────────

model GroupMatch {
  id         String    @id @default(cuid())
  groupId    String
  matchday   Int?
  date       DateTime?
  homeTeamId String
  awayTeamId String
  homeScore  Int?
  awayScore  Int?
  createdAt  DateTime  @default(now())

  group    Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  homeTeam OpposingTeam @relation("GroupMatchHome", fields: [homeTeamId], references: [id])
  awayTeam OpposingTeam @relation("GroupMatchAway", fields: [awayTeamId], references: [id])

  @@index([groupId])
  @@index([homeTeamId])
  @@index([awayTeamId])
}

// ── Partite ufficiali ─────────────────────────────────────────────────────────

model Match {
  id         String       @id @default(cuid())
  slug       String?      @unique  // es. "kapuleti-vs-roma-baskin-2025-10-12"
  teamId     String
  // Esattamente uno tra opponentId e opponentTeamId dev'essere valorizzato:
  // - opponentId: avversaria esterna (OpposingTeam) — per partite ufficiali e amichevoli vs esterni
  // - opponentTeamId: amichevole interna tra due nostre squadre (CompetitiveTeam)
  opponentId       String?
  opponentTeamId   String?
  date       DateTime
  isHome     Boolean      @default(true)
  venue      String?
  matchType  MatchType    @default(LEAGUE)
  ourScore   Int?
  theirScore Int?
  result     MatchResult?
  notes      String?      @db.Text
  imageUrl   String?      // copertina partita (Vercel Blob)
  createdAt  DateTime     @default(now())

  matchday Int?
  groupId  String?
  group    Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  // Timestamp dell'invio del reminder push "convocazioni mancanti" (T-3 giorni
  // con < roster minimo). Usato per garantire idempotenza del cron.
  callupReminderSentAt DateTime?

  team          CompetitiveTeam    @relation("MatchTeam", fields: [teamId], references: [id], onDelete: Cascade)
  opponent      OpposingTeam?      @relation(fields: [opponentId], references: [id])
  opponentTeam  CompetitiveTeam?   @relation("MatchOpponentTeam", fields: [opponentTeamId], references: [id])
  playerStats   PlayerMatchStats[]
  callups       MatchCallup[]
  mvps          MatchMvp[]
  availabilities MatchAvailability[]

  @@index([teamId, date])
  @@index([opponentId])
  @@index([opponentTeamId])
  @@index([groupId])
  @@map("OfficialMatch")
}

// ── Convocati per partita ─────────────────────────────────────────────────────

model MatchCallup {
  id      String @id @default(cuid())
  matchId String

  // Squadra per cui il giocatore è convocato. Nullable per retro-compatibilità
  // con i record creati prima dell'introduzione delle amichevoli interne; il
  // codice tratta null come "match.teamId" (la squadra principale della partita).
  // Per le amichevoli interne può essere match.teamId OPPURE match.opponentTeamId.
  teamId  String?

  userId  String?
  childId String?

  // true se il giocatore convocato NON è membro della squadra per cui è
  // convocato (teamId ?? match.teamId) nella stagione di quella squadra
  // — gioca quindi "in prestito" da un'altra squadra della società.
  isLoan Boolean @default(false)

  match Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team  CompetitiveTeam? @relation("MatchCallupTeam", fields: [teamId], references: [id], onDelete: SetNull)
  user  User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  child Child?           @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@unique([matchId, childId])
  @@index([matchId])
  @@index([teamId])
}

// ── MVP partita (scelti dai coach, max 3 per partita) ────────────────────────

model MatchMvp {
  id        String   @id @default(cuid())
  matchId   String
  userId    String?
  childId   String?
  createdAt DateTime @default(now())

  match Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  child Child? @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@unique([matchId, childId])
  @@index([matchId])
  @@index([userId])
  @@index([childId])
}

// ── Disponibilità giocatore per partita ──────────────────────────────────────
// Il giocatore (o il genitore per il Child) marca se è disponibile per una
// partita futura. Usato dai coach per le convocazioni.

model MatchAvailability {
  id        String   @id @default(cuid())
  matchId   String
  userId    String?
  childId   String?
  available Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  match Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  child Child? @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@unique([matchId, childId])
  @@index([matchId])
  @@index([userId])
  @@index([childId])
}

// ── Notifiche in-app ─────────────────────────────────────────────────────────

enum AppNotificationType {
  NEW_TRAINING
  TEAMS_READY
  MATCH_RESULT
  SYSTEM
  LINK_REQUEST    // richiesta collegamento genitore-figlio
  LINK_RESPONSE   // risposta alla richiesta (accettata/rifiutata)
  BIRTHDAY
}

enum LinkRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model AppNotification {
  id        String              @id @default(cuid())
  type      AppNotificationType
  title     String
  body      String
  url       String?
  createdAt DateTime            @default(now())

  // Se impostato, la notifica è visibile solo a quell'utente
  targetUserId String?
  targetUser   User?   @relation("TargetedNotifications", fields: [targetUserId], references: [id], onDelete: Cascade)

  reads AppNotificationRead[]

  @@index([createdAt])
  @@index([targetUserId])
}

model AppNotificationRead {
  id             String   @id @default(cuid())
  notificationId String
  userId         String
  readAt         DateTime @default(now())

  notification AppNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId])
}

// ── Statistiche giocatore per partita ────────────────────────────────────────

model PlayerMatchStats {
  id              String @id @default(cuid())
  matchId         String
  points          Int    @default(0) // = 2*twoPointers + 3*threePointers + freeThrows (calcolato server-side)
  twoPointers     Int    @default(0) // canestri da 2 punti
  threePointers   Int    @default(0) // canestri da 3 punti
  freeThrows      Int    @default(0) // tiri liberi (1 punto)
  fouls           Int    @default(0) // falli normali
  illegalFouls    Int    @default(0) // falli illegali (solo R4/R5)
  shotsAttempted  Int    @default(0) // tiri tentati (solo R5)
  notes           String? @db.Text

  // true se il giocatore NON è membro della squadra che ha disputato la partita
  // per quella stagione (ha giocato "in prestito"). Calcolato automaticamente
  // al salvataggio.
  isLoan Boolean @default(false)

  // Esattamente uno dei due deve essere valorizzato
  userId  String?
  childId String?

  match Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  child Child? @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@unique([matchId, childId])
  @@index([matchId])
  @@index([userId])
  @@index([childId])
}

// ── Audit log ────────────────────────────────────────────────────────────────

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String
  action     String   // es. "UPDATE_ROLE", "DELETE_USER", "ADD_MEMBER", "REMOVE_MEMBER"
  targetType String   // es. "User", "Child", "TeamMembership"
  targetId   String
  before     Json?    // snapshot prima della modifica
  after      Json?    // snapshot dopo la modifica
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// ── Eventi generici ───────────────────────────────────────────────────────────

model Event {
  id          String    @id @default(cuid())
  title       String
  date        DateTime
  endDate     DateTime?  // per eventi multi-giorno (es. torneo)
  location    String?
  description String?   @db.Text
  imageUrl    String?   // copertina evento (Vercel Blob)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([date])
}
