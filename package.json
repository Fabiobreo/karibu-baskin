{
  "name": "karibu-baskin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rimraf -rf .next && next dev",
    "build": "prisma db push --skip-generate --accept-data-loss && prisma generate && next build",
    "db:deploy": "prisma migrate deploy",
    "start": "next start",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "email:dev": "email dev --dir src/emails --port 3333",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.0",
    "@hookform/resolvers": "^5.2.2",
    "@mui/icons-material": "^6.4.8",
    "@mui/material": "^6.4.8",
    "@mui/material-nextjs": "^7.3.9",
    "@mui/x-date-pickers": "^7.28.1",
    "@prisma/client": "^6.5.0",
    "@react-email/components": "^1.0.12",
    "@sentry/nextjs": "^10.53.1",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-query-devtools": "^5.100.11",
    "@tiptap/extension-link": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "@types/dompurify": "^3.0.5",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.4.0",
    "date-fns": "^4.1.0",
    "html2canvas": "^1.4.1",
    "isomorphic-dompurify": "^3.14.0",
    "next": "^16.2.1",
    "next-auth": "^5.0.0-beta.30",
    "next-intl": "^4.13.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.76.0",
    "resend": "^6.12.2",
    "sharp": "^0.34.5",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "overrides": {
    "@swc/helpers": ">=0.5.17"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@playwright/test": "^1.60.0",
    "@react-email/ui": "^6.0.0",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.4.0",
    "@storybook/nextjs-vite": "^10.4.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.3",
    "eslint-plugin-storybook": "^10.4.0",
    "husky": "^9.1.7",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "prisma": "^6.5.0",
    "react-email": "^6.0.0",
    "rimraf": "^6.1.3",
    "storybook": "^10.4.0",
    "typescript": "^5",
    "vite": "^8.0.13",
    "vitest": "^4.1.5"
  }
}
